{
  "name": "dualaudio-hub",
  "version": "1.0.0",
  "author": "DualAudio",
  "description": "Single Virtual Audio Input → Dual Bluetooth Simultaneous Streamer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.dualaudio.hub",
    "productName": "DualAudio Hub",
    "copyright": "DualAudio Hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": "engine_host.ps1",
        "to": "engine_host.ps1"
      },
      {
        "from": "DualAudioEngine.cs",
        "to": "DualAudioEngine.cs"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DualAudio Hub"
    },
    "portable": {
      "artifactName": "DualAudioHub-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^27.3.11",
    "electron-builder": "^24.9.1"
  }
}
